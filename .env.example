# Proxmox MCP Server Environment Configuration

# Proxmox API endpoint components
# IMPORTANT: host only here, without https:// and without :8006
PROXMOX_HOST=192.168.1.10
PROXMOX_PORT=8006

# API token authentication (recommended)
# Example user: mcp@pve
PROXMOX_USER=mcp@pve
PROXMOX_TOKEN_NAME=chatgpt
PROXMOX_TOKEN_VALUE=replace-with-token-secret

# Alternative password authentication (not recommended for normal use)
# PROXMOX_PASSWORD=replace-with-password

# SSL verification. Use true with a trusted certificate.
PROXMOX_VERIFY_SSL=false

# Destructive MCP tools are blocked by default even if the API token allows them.
# When enabled, each destructive call still requires confirm=true.
PROXMOX_ALLOW_DESTRUCTIVE=false

# ---- MCP transport ----
# stdio keeps the original local-process transport.
# streamable-http exposes an HTTP MCP endpoint suitable for reverse proxies/tunnels.
MCP_TRANSPORT=stdio
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8000
MCP_HTTP_PATH=/mcp

# DNS-rebinding protection is always enabled in HTTP mode.
# Put every Host header that is allowed to reach the MCP here.
# Example behind Cloudflare: mcp.example.com,192.168.1.50:8000
MCP_HTTP_ALLOWED_HOSTS=127.0.0.1:*,localhost:*

# Usually empty for non-browser MCP clients. Add exact browser origins only if needed.
MCP_HTTP_ALLOWED_ORIGINS=

# Trust forwarded headers only from known reverse proxies where possible.
MCP_HTTP_FORWARDED_ALLOW_IPS=127.0.0.1
MCP_HTTP_LOG_LEVEL=info

# ---- Guest SSH operations (VM + LXC) ----
# Disabled by default. Enable only after configuring a dedicated guest SSH key.
PROXMOX_GUEST_OPS_ENABLED=false
PROXMOX_GUEST_SSH_USER=root
PROXMOX_GUEST_SSH_PORT=22
PROXMOX_GUEST_SSH_TIMEOUT=30
PROXMOX_GUEST_SSH_KEY=/run/proxmox-mcp-ssh/id_ed25519
PROXMOX_GUEST_KNOWN_HOSTS=/run/proxmox-mcp-ssh/known_hosts
PROXMOX_GUEST_STRICT_HOST_KEY=true

# Strongly recommended: comma-separated IPs/hostnames the MCP is allowed to access.
# Example: 192.168.1.50,192.168.1.51,test-lxc.lan
PROXMOX_GUEST_HOST_ALLOWLIST=

# Public destinations are blocked by default.
PROXMOX_GUEST_ALLOW_PUBLIC=false
PROXMOX_GUEST_MAX_OUTPUT=65536
